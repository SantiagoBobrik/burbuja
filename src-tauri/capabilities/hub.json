{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "hub",
  "description": "Main window (Hub): settings, history, models, onboarding, custom title bar",
  "windows": ["hub"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-microphones",
    "allow-start-mic-preview",
    "allow-stop-mic-preview",
    "allow-play-sound",
    "allow-start-hands-free",
    "allow-cancel-dictation",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model",
    "allow-set-active-model",
    "allow-get-engine-status",
    "allow-test-provider",
    "allow-detect-local-llms",
    "allow-get-history",
    "allow-delete-history-item",
    "allow-clear-history",
    "allow-copy-history-item",
    "allow-retry-cleanup",
    "allow-get-stats",
    "allow-record-hotkey",
    "allow-cancel-record-hotkey",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-open-logs-folder",
    "allow-open-permission-settings",
    "allow-get-permissions",
    "allow-request-permission",
    "allow-restart-app",
    "allow-reset-permission",
    "allow-reset-settings",
    "allow-get-last-timings"
  ]
}
