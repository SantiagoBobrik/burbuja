{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Burbuja",
  "version": "0.1.0",
  "identifier": "com.burbuja.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "hub",
        "create": false,
        "title": "Burbuja",
        "width": 880,
        "height": 600,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundColor": "#111111",
        "theme": "Dark",
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources": "resources"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
